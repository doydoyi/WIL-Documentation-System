# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret (service-role) key. Server-only: bypasses Row Level Security.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Application ---------------------------------------------------------------
# Public base URL; used for the Google OAuth redirect URI.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# University Google Workspace domain. Only these accounts can sign in.
ALLOWED_EMAIL_DOMAIN=cit.edu
# Office segment of document codes (WIL-EVT-A0-2026-001).
OFFICE_CODE=WIL
# First Administrator: created on first sign-in while no Administrator exists.
BOOTSTRAP_ADMIN_EMAIL=

# --- Google Workspace Internal OAuth app (Shared Drive access) ---------------
# Authorized redirect URI: ${NEXT_PUBLIC_SITE_URL}/api/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
